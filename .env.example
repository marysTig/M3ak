# =============================================================================
# M3ak — Variables d'environnement
# =============================================================================
# IMPORTANT : Ne jamais committer ce fichier avec de vraies clés secrètes.
# Copiez ce fichier en .env et remplissez vos vraies valeurs.
# =============================================================================

# ─── EmailJS Configuration ───────────────────────────────────────────────────
# Pour activer l'envoi d'emails réels :
# 1. Créez un compte sur https://www.emailjs.com/
# 2. Créez un Service (Gmail, Outlook, etc.)
# 3. Créez un Template avec les variables :
#    {{to_email}}, {{to_name}}, {{business_name}}, {{points}}, {{qr_token}}
# 4. Copiez vos IDs ci-dessous

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ─── Supabase Configuration ──────────────────────────────────────────────────
# 1. Créez un projet sur https://supabase.com/
# 2. Allez dans Settings > API
# 3. Copiez Project URL et Publishable (anon) key

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ─── Cloudinary Configuration ────────────────────────────────────────────────
# 1. Créez un compte sur https://cloudinary.com/
# 2. Allez dans Settings > Upload > Upload presets
# 3. Créez un preset "Unsigned" et copiez son nom
# ⚠️  CLOUDINARY_API_SECRET = usage SERVEUR UNIQUEMENT. Ne jamais le préfixer VITE_.

VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_API_KEY=your-api-key
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name
CLOUDINARY_API_SECRET=your-api-secret-server-only

# =============================================================================
# Si ces variables EmailJS sont vides, les emails seront SIMULÉS (log console uniquement).
# La création de carte fonctionne normalement même sans EmailJS configuré.
# =============================================================================
